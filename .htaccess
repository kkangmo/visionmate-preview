DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # One-hop canonical redirect: http or non-www -> https://www (Cloudways proxy sends X-Forwarded-Proto: https on https requests)
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [OR]
  RewriteCond %{HTTP_HOST} ^visionmate\.co\.kr$ [NC]
  RewriteRule ^ https://www.visionmate.co.kr%{REQUEST_URI} [R=301,L]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>
